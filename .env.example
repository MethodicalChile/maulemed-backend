# ── MauleMed Backend — Variables de entorno ──────────────────────────────────
# Copia este archivo como .env y rellena los valores para tu entorno.
# El archivo .env real está en .gitignore y nunca se debe commitear.

# Django
SECRET_KEY=cambia-esto-por-una-clave-segura-en-produccion
DEBUG=True

# Base de datos PostgreSQL
DB_NAME=postgres
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Supabase (storage de archivos)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_STORAGE_BUCKET=MauleMed-Imagenes

# CORS y hosts permitidos (separados por coma, sin espacios)
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Google OAuth (Login con Google)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google Forms API (para publicar formularios de evaluación)
# Generar con apps/utils.py/generate_google_token.py — solo una vez por entorno
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token

# ── Solo para CI / tests ──────────────────────────────────────────────────────
# En el pipeline de CI se sobreescriben DB_* con SQLite o una DB de test:
# CI_DATABASE_URL=sqlite:///test_db.sqlite3
