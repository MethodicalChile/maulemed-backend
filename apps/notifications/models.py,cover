> from django.conf import settings
> from django.db import models
  
> from apps.common.models import BaseModel
  
  
> class Notification(BaseModel):
>     TYPE_INFO = "INFO"
>     TYPE_WARNING = "WARNING"
>     TYPE_ERROR = "ERROR"
>     TYPE_SUCCESS = "SUCCESS"
  
>     TYPE_STOCK_LOW = "STOCK_BAJO"
>     TYPE_STOCK_EXPIRED = "STOCK_VENCIDO"
>     TYPE_SUPPLY_REQUEST = "SOLICITUD_INSUMOS"
>     TYPE_PURCHASE_ORDER = "ORDEN_COMPRA"
>     TYPE_TRANSFER = "TRASPASO"
>     TYPE_SUPPLIER_CLAIM = "RECLAMO_PROVEEDOR"
>     TYPE_PAYMENT = "PAGO"
>     TYPE_SYSTEM = "SISTEMA"
  
>     NOTIFICATION_TYPE_CHOICES = [
>         (TYPE_INFO, "Información"),
>         (TYPE_WARNING, "Advertencia"),
>         (TYPE_ERROR, "Error"),
>         (TYPE_SUCCESS, "Éxito"),
>         (TYPE_STOCK_LOW, "Stock bajo"),
>         (TYPE_STOCK_EXPIRED, "Stock vencido"),
>         (TYPE_SUPPLY_REQUEST, "Solicitud de insumos"),
>         (TYPE_PURCHASE_ORDER, "Orden de compra"),
>         (TYPE_TRANSFER, "Traspaso"),
>         (TYPE_SUPPLIER_CLAIM, "Reclamo proveedor"),
>         (TYPE_PAYMENT, "Pago"),
>         (TYPE_SYSTEM, "Sistema"),
>     ]
  
>     user = models.ForeignKey(
>         settings.AUTH_USER_MODEL,
>         on_delete=models.CASCADE,
>         related_name="notifications",
>     )
  
>     title = models.CharField(max_length=180)
>     message = models.TextField(blank=True, null=True)
  
>     notification_type = models.CharField(
>         max_length=80,
>         choices=NOTIFICATION_TYPE_CHOICES,
>         default=TYPE_INFO,
>     )
  
>     related_app = models.CharField(max_length=80, blank=True, null=True)
>     related_model = models.CharField(max_length=80, blank=True, null=True)
>     related_uuid = models.UUIDField(blank=True, null=True)
  
>     is_read = models.BooleanField(default=False)
>     read_at = models.DateTimeField(blank=True, null=True)
  
>     class Meta:
>         db_table = "notifications"
>         verbose_name = "Notification"
>         verbose_name_plural = "Notifications"
>         indexes = [
>             models.Index(fields=["user", "is_read"], name="idx_notif_user_read"),
>             models.Index(fields=["notification_type"], name="idx_notif_type"),
>             models.Index(fields=["related_model", "related_uuid"], name="idx_notif_related"),
>             models.Index(fields=["created_at"], name="idx_notif_created_at"),
>         ]
  
>     def __str__(self):
>         return f"{self.user} - {self.title}"
