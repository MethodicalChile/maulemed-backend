>     ACTION_LOGIN = "LOGIN"
>     ACTION_LOGOUT = "LOGOUT"
>     ACTION_APPROVE = "APPROVE"
>     ACTION_REJECT = "REJECT"
>     ACTION_EXPORT = "EXPORT"
